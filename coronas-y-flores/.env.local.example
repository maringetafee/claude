# URL pública de la web (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (nunca con prefijo NEXT_PUBLIC). Crea pedidos y los marca como pagados.
SUPABASE_SERVICE_ROLE_KEY=

# Redsys (TPV virtual del banco). Sin estas claves la tienda usa el comercio de
# PRUEBAS público de Redsys: se puede comprar de principio a fin sin cobrar.
# Datos del banco: código de comercio (FUC), terminal y clave SHA-256.
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
# test = entorno de pruebas · live = cobrar de verdad
REDSYS_ENV=test

# Resend → API Keys. Sin clave la tienda funciona, pero no se envían emails.
RESEND_API_KEY=
# Remitente de los emails. Hasta verificar el dominio en Resend usa onboarding@resend.dev
EMAIL_FROM="Coronas y Flores <onboarding@resend.dev>"
