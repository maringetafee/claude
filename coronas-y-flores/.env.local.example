# URL pública de la web (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (nunca con prefijo NEXT_PUBLIC). Crea pedidos y los marca como pagados.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (sk_test_... para pruebas, sk_live_... en producción)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://TU-DOMINIO/api/stripe/webhook
# (en local: `stripe listen --forward-to localhost:3000/api/stripe/webhook`)
STRIPE_WEBHOOK_SECRET=

# Resend → API Keys. Sin clave la tienda funciona, pero no se envían emails.
RESEND_API_KEY=
# Remitente de los emails. Hasta verificar el dominio en Resend usa onboarding@resend.dev
EMAIL_FROM="Coronas y Flores <onboarding@resend.dev>"
