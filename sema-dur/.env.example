# Sema-Dur — environment
# Copy to `.env` for local dev, or set in the Netlify site UI for production.

# --- Stripe (optional; the shop works as quote-first without it) ---
# When set, netlify/functions/create-checkout.mjs starts creating real
# Checkout Sessions. Never expose the secret key to the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://www.sema-dur.com/gracias/?paid=1
STRIPE_CANCEL_URL=https://www.sema-dur.com/carrito/

# Publishable key (safe for the client) — only needed if you add Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
