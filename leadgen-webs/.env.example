# Copia este archivo a ".env" y rellena tu clave real. Nunca subas ".env" a git.

# API key de Google Cloud con "Places API (New)" habilitada.
GOOGLE_PLACES_API_KEY=

# Dominio donde vas a colgar las webs de muestra generadas (Netlify, etc.),
# se usa para construir el link de preview en los borradores de email.
# Ejemplo: https://propuestas-webs.netlify.app
PREVIEW_BASE_URL=

# El panel interno (index.html, datos.html) vive en la raiz del sitio y esta
# protegido con HTTP Basic Auth (usuario "make", contraseña "web") via
# netlify/edge-functions/panel-auth.js — no hace falta configurar nada aqui,
# las credenciales estan en ese archivo (que si se sube a git, cambialas ahi
# si quieres otras distintas).
