# Copia este archivo a ".env" y rellena tu clave real. Nunca subas ".env" a git.

# API key de Google Cloud con "Places API (New)" habilitada.
GOOGLE_PLACES_API_KEY=

# Dominio donde vas a colgar las webs de muestra generadas (Netlify, etc.),
# se usa para construir el link de preview en los borradores de email.
# Ejemplo: https://propuestas-webs.netlify.app
PREVIEW_BASE_URL=

# Ruta (no la raiz) donde se publica el panel interno de leads, para que
# alguien que reciba el link de una demo y recorte la URL hasta el dominio
# no caiga en el listado de todos tus leads. Invéntate algo no adivinable,
# no uses "panel" ni "admin". Ejemplo: PANEL_SLUG=panel-7c4f91ab
PANEL_SLUG=
